{
  "manifest_version": 3,
  "name": "EnglishVocab — lưu từ cá nhân",
  "version": "0.1.0",
  "description": "Bôi đen để tra từ và lưu từ vựng về EnglishVocab.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://freedictionaryapi.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}