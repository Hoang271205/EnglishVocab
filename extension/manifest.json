{
  "manifest_version": 3,
  "name": "EnglishVocab — lưu từ cá nhân",
  "version": "0.1.0",
  "description": "Nền tra từ và hàng đợi capture; giao diện bôi đen sẽ được bổ sung sau Gate-BE.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://freedictionaryapi.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
