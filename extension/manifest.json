{
  "manifest_version": 3,
  "name": "EnglishVocab — lưu từ cá nhân",
  "version": "0.1.0",
  "description": "Bôi đen, tra nghĩa và lưu từ trực tiếp vào tài khoản EnglishVocab.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://freedictionaryapi.com/*",
    "https://api.mymemory.translated.net/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tài khoản EnglishVocab",
    "default_popup": "account.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/mascot/englishvocab-mascot.png"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
