{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "extension/**/*.ts",
    "extension/**/*.tsx",
    "api/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-extension", "dist-server", "legacy"]
}
