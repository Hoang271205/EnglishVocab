NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:3001
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=englishvocab
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Gmail SMTP: use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=EnglishVocab <your-account@gmail.com>

# On Vercel, set these values in Project Settings > Environment Variables.
# NODE_ENV=production
# APP_ORIGIN=https://your-project.vercel.app
# EXTENSION_APP_ORIGIN=https://your-project.vercel.app
# HOST and PORT are only used by the standalone server, not Vercel Functions.
