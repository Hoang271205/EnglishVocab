{
  "name": "englishvocab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "user:create": "tsx server/src/scripts/create-user.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node dist-server/server/src/index.js",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build": "npm run typecheck && npm run build:frontend",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src extension tests scripts --max-warnings=0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:navigation": "npm run build:frontend && node --import tsx --test tests/browser/navigation.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:gate": "node scripts/check-gate.mjs",
    "progress": "node scripts/progress.mjs",
    "start": "node scripts/serve.mjs --open",
    "validate:content": "node --import tsx scripts/validate-content.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "progress:update": "node scripts/progress.mjs --write",
    "enrich:ipa": "node --import tsx scripts/enrich-ipa.mjs",
    "content:build": "node --import tsx scripts/build-authored-pack.mjs",
    "content:index": "node --import tsx scripts/index-content.mjs",
    "crawl:api": "node --import tsx scripts/crawl-api.mjs",
    "crawl:download": "node scripts/fetch-wiktionary.mjs",
    "crawl:bulk": "node --import tsx scripts/crawl-bulk.mjs",
    "crawl:sentences": "node --import tsx scripts/crawl-sentences.mjs",
    "crawl:publish": "node --import tsx scripts/publish-crawl.mjs",
    "crawl:archive": "node scripts/archive-crawl.mjs",
    "crawl:archive:verify": "node scripts/archive-crawl.mjs --verify",
    "crawl:download:sentences": "node scripts/fetch-sentences.mjs",
    "crawl:download:sentences:full": "node scripts/fetch-sentences.mjs --detailed",
    "crawl:sentences:cc0": "node --import tsx scripts/crawl-cc0.mjs",
    "crawl:sentences:full": "node --import tsx scripts/crawl-cc0.mjs --detailed",
    "crawl:propose": "node scripts/propose-crawl.mjs",
    "crawl:filter": "node scripts/filter-crawl.mjs",
    "format:frontend": "prettier --write \"src/frontend/**/*.{ts,tsx,css}\"",
    "format:frontend:check": "prettier --check \"src/frontend/**/*.{ts,tsx,css}\"",
    "library:seed": "tsx server/src/scripts/seed-library.ts",
    "library:import-reviewed": "tsx server/src/scripts/import-reviewed-content.ts",
    "test:legacy": "node --import tsx --test legacy/local/tests/*.test.ts",
    "build:vercel": "npm run build:frontend",
    "db:prepare": "tsx server/src/scripts/prepare-database.ts",
    "db:migrate:topics": "tsx server/src/scripts/migrate-topic-learning.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "@vercel/speed-insights": "^2.0.0",
    "connect-mongo": "^6.0.0",
    "dexie": "4.4.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.4",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
